# Шаблон: переменные ${...} подставляются при старте контейнера nginx (см. compose.yaml)
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 100m;

    # REST API локального игрового сервера
    location /api/ {
        proxy_pass http://${GAME_SERVER_HOST}:${GAME_SERVER_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # SignalR (WebSocket): комнаты и игра
    location ~ ^/(sionline|sihost) {
        proxy_pass http://${GAME_SERVER_HOST}:${GAME_SERVER_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Сервис контента (картинки, аватарки, файлы пакетов)
    location /sicontent/ {
        proxy_pass http://${CONTENT_HOST}:${CONTENT_PORT}/;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
